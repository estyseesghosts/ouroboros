From 4709a335fcf2ee9e79b568268ca28a3fcf994ccc Mon Sep 17 00:00:00 2001
From: terezi <jules@foxtails.me>
Date: Mon, 2 Nov 2026 17:40:42 -0500
Subject: [PATCH 2/5] nvc0/switch: disable compressed kinds without comptag
 backing

The Switch winsys fakes drm version 0x01000202, which enables
compressed Z/MSAA kinds, but Horizon allocations never get comptags.
Depth tests then reject every world pixel. Default compression off on
__SWITCH__; NOUVEAU_SWITCH_COMPRESSION=1 restores it for A/B.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../drivers/nouveau/nvc0/nvc0_miptree.c       |  6 +++++
 .../drivers/nouveau/nvc0/nvc0_screen.c        | 25 ++++++++++++++++---
 .../drivers/nouveau/nvc0/nvc0_screen.h        |  1 +
 3 files changed, 29 insertions(+), 3 deletions(-)

diff --git a/src/gallium/drivers/nouveau/nvc0/nvc0_miptree.c b/src/gallium/drivers/nouveau/nvc0/nvc0_miptree.c
index 7db2707b0d9..aea5cf7fc6b 100644
--- a/src/gallium/drivers/nouveau/nvc0/nvc0_miptree.c
+++ b/src/gallium/drivers/nouveau/nvc0/nvc0_miptree.c
@@ -448,7 +448,13 @@ nvc0_miptree_create(struct pipe_screen *pscreen,
    struct nouveau_drm *drm = nouveau_screen(pscreen)->drm;
    struct nv50_miptree *mt = CALLOC_STRUCT(nv50_miptree);
    struct pipe_resource *pt = &mt->base.base;
+#ifdef __SWITCH__
+   /* See nvc0_switch_compression_enabled(): no comptags on Horizon. */
+   bool compressed = nvc0_switch_compression_enabled();
+   (void)drm;
+#else
    bool compressed = drm->version >= 0x01000101;
+#endif
    int ret;
    union nouveau_bo_config bo_config;
    uint32_t bo_flags;
diff --git a/src/gallium/drivers/nouveau/nvc0/nvc0_screen.c b/src/gallium/drivers/nouveau/nvc0/nvc0_screen.c
index f27b83465af..94632a08d18 100644
--- a/src/gallium/drivers/nouveau/nvc0/nvc0_screen.c
+++ b/src/gallium/drivers/nouveau/nvc0/nvc0_screen.c
@@ -72,6 +72,21 @@ nvc0_switch_diagnostics_enabled(void)
           debug_get_bool_option("NOUVEAU_SWITCH_STATS", false);
 }
 
+/* Compressible PTE kinds need compression tags (comptags) attached to the
+ * backing NvMap handle.  The Horizon winsys always allocates Pitch-kind
+ * backing with no comptags and maps it with whatever PTE kind the miptree
+ * picked, and nothing downgrades the kind the way the Linux kernel does when
+ * tags are unavailable.  Depth/stencil (Z24S8 -> 0x51/0x17) and MSAA colour
+ * targets then render through compression state the hardware never backs,
+ * so depth reads/clears are garbage and every depth-tested fragment fails
+ * (black 3D world while depth-less 2D/UI passes still draw).  Keep
+ * compression off unless explicitly requested. */
+bool
+nvc0_switch_compression_enabled(void)
+{
+   return debug_get_bool_option("NOUVEAU_SWITCH_COMPRESSION", false);
+}
+
 bool
 nvc0_switch_zbc_update(struct nvc0_screen *screen,
                        struct nouveau_pushbuf *push,
@@ -1504,11 +1519,15 @@ nvc0_screen_create(struct nouveau_device *dev)
       PUSH_DATA (push, 0x17);
    }
 
-   IMMED_NVC0(push, NVC0_3D(ZETA_COMP_ENABLE),
-                    screen->base.drm->version >= 0x01000101);
+#ifdef __SWITCH__
+   const bool comp_enable = nvc0_switch_compression_enabled();
+#else
+   const bool comp_enable = screen->base.drm->version >= 0x01000101;
+#endif
+   IMMED_NVC0(push, NVC0_3D(ZETA_COMP_ENABLE), comp_enable);
    BEGIN_NVC0(push, NVC0_3D(RT_COMP_ENABLE(0)), 8);
    for (i = 0; i < 8; ++i)
-      PUSH_DATA(push, screen->base.drm->version >= 0x01000101);
+      PUSH_DATA(push, comp_enable);
 
    BEGIN_NVC0(push, NVC0_3D(RT_CONTROL), 1);
    PUSH_DATA (push, 1);
diff --git a/src/gallium/drivers/nouveau/nvc0/nvc0_screen.h b/src/gallium/drivers/nouveau/nvc0/nvc0_screen.h
index 685c9c4df26..f4660416457 100644
--- a/src/gallium/drivers/nouveau/nvc0/nvc0_screen.h
+++ b/src/gallium/drivers/nouveau/nvc0/nvc0_screen.h
@@ -238,6 +238,7 @@ bool nvc0_blitter_create(struct nvc0_screen *);
 bool nvc0_switch_zbc_update(struct nvc0_screen *screen,
                             struct nouveau_pushbuf *push,
                             uint64_t *generation);
+bool nvc0_switch_compression_enabled(void);
 #endif
 void nvc0_blitter_destroy(struct nvc0_screen *);
 
